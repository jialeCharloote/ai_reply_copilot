# Charla — copy to .env (or export in your shell) and fill in.
# The Slack app reads these from the environment; nothing here is committed.

# LLM (drafting). Default model is claude-opus-4-8; --model claude-sonnet-5 is cheaper/faster.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...            # optional alternative provider

# --- Slack app (dogfood, single workspace) ---
# App-level token for Socket Mode (starts with xapp-); scope: connections:write
SLACK_APP_TOKEN=xapp-...
# Bot token (xoxb-): used only to open the modal via trigger_id
SLACK_BOT_TOKEN=xoxb-...
# YOUR user token (xoxp-): reads what you can see and posts replies AS YOU.
# User scopes: channels:history, groups:history, im:history, mpim:history,
#              users:read, chat:write
SLACK_USER_TOKEN=xoxp-...
